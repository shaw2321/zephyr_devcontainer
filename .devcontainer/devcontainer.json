{
  "name": "Zephyr Dev (Codespaces)",
  "image": "ghcr.io/zephyrproject-rtos/ci:v0.33.0", 
  "features": {},
  "remoteUser": "root",

  // Codespaces 建议开启 containerFeatures
  "updateContentCommand": "west init -l && west update --narrow --fetch-opt=--depth=1",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "nordic-semiconductor.nrf-connect"   // 可选
      ]
    }
  },

  "postCreateCommand": "pip3 install --upgrade pip",
  "mounts": [
    // 持久缓存，可加快构建（可选）
    "source=/tmp/.ccache,target=/workspaces/.ccache,type=bind"
  ]
}
